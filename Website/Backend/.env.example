# Copy this file to .env and fill in your values.
# .env is gitignored; this file is safe to commit.
# Never commit .env to source control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL + PostGIS connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edgeai

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Path to the seeded asset JSON file (relative to backend/)
SEED_DATA_PATH=ingestion/seed_data.json

# Geocoding user agent (required by Nominatim terms of service)
GEOCODING_USER_AGENT=edgeai-location-intelligence/1.0

# ── Auth — JWT ────────────────────────────────────────────────────────────────
# Generate a fresh secret for every environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER share production secrets. NEVER commit real values here.
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
JWT_ALGORITHM=HS256
# Access token lifetime in minutes. 30 is the default.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Auth — Cookie ─────────────────────────────────────────────────────────────
# Set to true in production (HTTPS). Keep false for local HTTP development.
# SameSite=Lax is always used; localhost:3000 → localhost:8000 is same-site.
COOKIE_SECURE=false

# ── Future concerns (not yet implemented) ─────────────────────────────────────
# Refresh tokens: not yet built. Add REFRESH_TOKEN_EXPIRE_DAYS when implemented.
# Rate limiting on /api/auth/*: use a reverse proxy (nginx/caddy) or slowapi.
#   Not yet configured in application code.
# Server-side token blacklisting on logout: current logout is client-side token
#   discard only (stateless JWT). Server-side blacklisting requires a Redis store
#   or a DB revocation table — documented as a future concern.
